# Required for live weather data in /monitor/location
TOMORROW_API_KEY=your_tomorrow_api_key

# Twilio SMS configuration
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token

# You can use either TWILIO_FROM_NUMBER or TWILIO_PHONE_NUMBER
TWILIO_FROM_NUMBER=+1234567890
# TWILIO_PHONE_NUMBER=+1234567890

# Comma-separated emergency recipient phone numbers
EMERGENCY_CONTACTS=+15550000001,+15550000002

# Enable or disable SMS alerts globally
SMS_ALERTS_ENABLED=true
